#!/bin/bash
#
# First-boot installer for the Bobcat Reticulum node image.
#
# Runs once (systemd unit bobcat-firstboot.service). Settings come from files
# that were placed on the boot partition (FAT) before flashing. The eMMC flasher
# copies them there from the SD card; for the standalone image you put them there
# yourself:
#
#   /boot/bobcat-install.conf       settings, KEY=value lines (docs/config-reference.md)
#   /boot/bobcat-netplan.yaml       optional: a complete netplan config
#   /boot/bobcat-authorized_keys    optional: SSH public keys for root
#   /boot/bobcat-reticulum.conf     optional: a complete Reticulum config
#
# This script copies them into the installed system under /etc/bobcat-lora/
# (root-only), merges them with any settings baked into the image, and runs the
# bundled installer with the result. The installer does all the parsing and
# validation; the files are never executed.
#
# Log: /var/log/bobcat-firstboot.log   Marker: /var/lib/bobcat-lora/firstboot.done

set -uo pipefail

# Paths can be overridden through the environment (used by the tests).
INSTALLER="${BOBCAT_INSTALLER:-/usr/local/share/bobcat-lora/bobcat-g295-install.sh}"
STATE="${BOBCAT_STATE:-/var/lib/bobcat-lora}"
DONE="$STATE/firstboot.done"
LOG="${BOBCAT_LOG:-/var/log/bobcat-firstboot.log}"
SEED="${BOBCAT_SEED:-/etc/bobcat-lora}"
BOOT_DIR="${BOBCAT_BOOT_DIR:-/boot}"
SKIP_SYSTEM="${BOBCAT_TEST_SKIP_SYSTEM:-0}"   # tests: no apt-mark/systemctl/time wait

BAKED="$SEED/install.conf"            # baked into the image at build time (optional)
EFFECTIVE="$SEED/effective.conf"      # what the installer is given
BOOT_CONF="$BOOT_DIR/bobcat-install.conf"

mkdir -p "$STATE"
exec > >(tee -a "$LOG") 2>&1
echo "== $(date -Is) bobcat-firstboot starting"

[[ -e "$DONE" ]] && { echo "already done"; exit 0; }
[[ -x "$INSTALLER" ]] || { echo "installer missing: $INSTALLER"; exit 1; }

# Never let an automatic upgrade replace the kernel or bootloader: the image
# documentation warns that doing so breaks boot.
if [[ "$SKIP_SYSTEM" != "1" ]]; then
    for pkg in linux-image-current-rockchip64 linux-dtb-current-rockchip64 \
               linux-u-boot-bobcat-29x-current; do
        dpkg -s "$pkg" >/dev/null 2>&1 && apt-mark hold "$pkg" >/dev/null
    done
fi

key_is_set() { grep -qE "^[[:space:]]*$1[[:space:]]*=[[:space:]]*[^[:space:]]" "$EFFECTIVE"; }

# Copy one optional side file into the system and point the config at it,
# unless the settings file already names one itself.
attach_side_file() {   # attach_side_file <name on boot partition> <name here> <KEY>
    local src="$BOOT_DIR/$1" dest="$SEED/files/$2" key="$3"
    [[ -r "$src" ]] || return 0
    if key_is_set "$key"; then
        echo "$1: not used, the settings file already sets $key"
        return 0
    fi
    install -m 600 "$src" "$dest"
    printf '%s=%s\n' "$key" "$dest" >> "$EFFECTIVE"
    echo "using $1"
}

seed_config() {
    install -d -m 700 "$SEED" "$SEED/files"
    : > "$EFFECTIVE"
    chmod 600 "$EFFECTIVE"

    if [[ -r "$BAKED" ]]; then
        echo "reading settings baked into the image"
        { echo "# --- baked into the image"; tr -d '\r' < "$BAKED"; echo; } >> "$EFFECTIVE"
    fi
    if [[ -r "$BOOT_CONF" ]]; then
        echo "reading $BOOT_CONF"
        { echo "# --- $BOOT_CONF"; tr -d '\r' < "$BOOT_CONF"; echo; } >> "$EFFECTIVE"
    else
        echo "no $BOOT_CONF: installing with defaults (wired network needed)"
    fi

    attach_side_file bobcat-authorized_keys authorized_keys SSH_AUTHORIZED_KEYS_FILE
    attach_side_file bobcat-reticulum.conf  reticulum.conf  RETICULUM_CONFIG_FILE
    # A complete netplan file replaces the Wi-Fi/Ethernet settings, so it cannot
    # be combined with them.
    if [[ -r "$BOOT_DIR/bobcat-netplan.yaml" ]] &&
       grep -qE '^[[:space:]]*(WIFI_SSID|ETH_MODE[[:space:]]*=[[:space:]]*(dhcp|static))' "$EFFECTIVE"; then
        echo "bobcat-netplan.yaml: not used, the settings file already configures Wi-Fi/Ethernet"
    else
        attach_side_file bobcat-netplan.yaml netplan.yaml NETPLAN_FILE
    fi
}

seed_config

# The board has no battery-backed clock. A stale clock makes TLS (apt, pip)
# fail with "certificate is not yet valid", so wait for time sync first.
echo "waiting for time sync (up to 3 min)"
for _ in $(seq 1 90); do
    [[ "$SKIP_SYSTEM" == "1" ]] && break
    [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" == "yes" ]] && break
    sleep 2
done
echo "clock: $(date -Is) synchronized=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)"

echo "running the installer with $EFFECTIVE"
if ! "$INSTALLER" --config "$EFFECTIVE"; then
    echo "== installer failed; systemd will retry"
    exit 1
fi

touch "$DONE"
echo "== $(date -Is) first-boot install complete"

# Do not leave secrets sitting in plain text on the FAT partition (readable from
# any computer). The root-only copy under $SEED keeps them for re-runs.
if [[ -w "$BOOT_CONF" ]] && ! grep -qE '^[[:space:]]*SCRUB_BOOT_CONF[[:space:]]*=[[:space:]]*(no|false|0|off)' "$BOOT_CONF" &&
   grep -qE '^[[:space:]]*(WIFI_PASS|IFAC_PASSPHRASE)[[:space:]]*=[^[:space:]]' "$BOOT_CONF"; then
    sed -i -E 's/^([[:space:]]*(WIFI_PASS|IFAC_PASSPHRASE)[[:space:]]*=).*/\1/' "$BOOT_CONF" &&
        echo "cleared passphrases in $BOOT_CONF"
fi
[[ "$SKIP_SYSTEM" == "1" ]] || systemctl disable bobcat-firstboot.service >/dev/null 2>&1 || true
exit 0
