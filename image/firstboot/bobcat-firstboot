#!/bin/bash
#
# First-boot installer for the Bobcat Reticulum node image.
#
# Runs once (systemd unit bobcat-firstboot.service). Settings come from files
# that were placed on the boot partition (FAT) before flashing. The eMMC flasher
# copies them there from the SD card; for the standalone image you put them there
# yourself:
#
#   /boot/bobcat-install.conf       settings, KEY=value lines (docs/config-reference.md)
#   /boot/bobcat-netplan.yaml       optional: a complete netplan config
#   /boot/bobcat-authorized_keys    optional: SSH public keys for root
#   /boot/bobcat-reticulum.conf     optional: a complete Reticulum config
#
# "/boot" is the small FAT partition (label armbi_boot). The large root partition
# has its own, empty /boot folder, which the FAT partition hides once mounted. From
# a computer both look like "the boot folder", so a file dropped in the root
# partition's /boot is found too (looked for second, and said so in the log).
#
# This script copies them into the installed system under /etc/bobcat-lora/
# (root-only), merges them with any settings baked into the image, and runs the
# bundled installer with the result. The installer does all the parsing and
# validation; the files are never executed.
#
# Log: /var/log/bobcat-firstboot.log   Marker: /var/lib/bobcat-lora/firstboot.done

set -uo pipefail

# Paths can be overridden through the environment (used by the tests).
INSTALLER="${BOBCAT_INSTALLER:-/usr/local/share/bobcat-lora/bobcat-g295-install.sh}"
STATE="${BOBCAT_STATE:-/var/lib/bobcat-lora}"
DONE="$STATE/firstboot.done"
LOG="${BOBCAT_LOG:-/var/log/bobcat-firstboot.log}"
SEED="${BOBCAT_SEED:-/etc/bobcat-lora}"
BOOT_DIR="${BOBCAT_BOOT_DIR:-/boot}"
RETRY_WAIT="${BOBCAT_RETRY_WAIT:-120}"          # wait after a failed attempt, blinking red
SKIP_SYSTEM="${BOBCAT_TEST_SKIP_SYSTEM:-0}"   # tests: no apt-mark/systemctl/time wait

# The root filesystem's own /boot folder, hidden under the FAT mount. Tests set
# BOBCAT_HIDDEN_BOOT_DIR directly instead of bind-mounting.
HIDDEN_BOOT_DIR="${BOBCAT_HIDDEN_BOOT_DIR:-}"
HIDDEN_MP=""
if [[ -z "$HIDDEN_BOOT_DIR" && "$SKIP_SYSTEM" != "1" ]] && mountpoint -q "$BOOT_DIR" 2>/dev/null; then
    HIDDEN_MP="$(mktemp -d)"
    if mount --bind / "$HIDDEN_MP" 2>/dev/null; then
        HIDDEN_BOOT_DIR="$HIDDEN_MP$BOOT_DIR"
    fi
fi

# Where a settings file was found: first the FAT boot partition, then the root
# filesystem's own /boot folder.
locate() {   # locate <file name>: prints the path, or nothing
    local d
    for d in "$BOOT_DIR" "$HIDDEN_BOOT_DIR"; do
        [[ -n "$d" && -r "$d/$1" ]] && { printf '%s\n' "$d/$1"; return 0; }
    done
    return 1
}
note_source() {   # note_source <path>: say so when it is not the FAT partition
    [[ -n "$HIDDEN_BOOT_DIR" && "$1" == "$HIDDEN_BOOT_DIR/"* ]] &&
        echo "note: $(basename "$1") was found in the root filesystem's /boot folder, not on the FAT boot partition; that works, but the FAT partition (armbi_boot) is the intended place"
    return 0
}

# Progress on the board's RGB LED. It sits on three GPIO lines (bank 4, lines 0-2: sysfs
# 128 blue, 129 green, 130 red; high = on), the same lines the flasher uses. The kernel's
# /sys/class/leds entries do not drive it. Best effort: a missing GPIO never matters.
#   blue, fast blink   installing
#   red, steady        no network: no IPv4 address after about 20 seconds (turns blue again once one appears)
#   red, slow blink    the last attempt failed; it waits about two minutes, then retries
#   green, steady      install complete
# sysfs-exported lines stay driven after this script exits, so a steady colour lasts.
LED_BLUE="${BOBCAT_LED_BLUE:-128}"
LED_GREEN="${BOBCAT_LED_GREEN:-129}"
LED_RED="${BOBCAT_LED_RED:-130}"
GPIO_DIR="${BOBCAT_GPIO_DIR:-/sys/class/gpio}"
LED_PID=""
led_line() {   # led_line <gpio> 0|1
    [[ -e "$GPIO_DIR/gpio$1" ]] || echo "$1" > "$GPIO_DIR/export" 2>/dev/null
    { echo out > "$GPIO_DIR/gpio$1/direction"; echo "$2" > "$GPIO_DIR/gpio$1/value"; } 2>/dev/null
    return 0
}
led_show() {   # led_show <blue 0|1> <green 0|1> <red 0|1>
    led_line "$LED_BLUE" "$1"; led_line "$LED_GREEN" "$2"; led_line "$LED_RED" "$3"
}
led_stop() {
    if [[ -n "$LED_PID" ]]; then
        kill "$LED_PID" 2>/dev/null
        wait "$LED_PID" 2>/dev/null
        LED_PID=""
    fi
    return 0
}
led_blink() {   # led_blink <blue> <green> <red> <seconds on> <seconds off>
    ( while :; do led_show "$1" "$2" "$3"; sleep "$4"; led_show 0 0 0; sleep "$5"; done ) >/dev/null 2>&1 &
    LED_PID=$!
}
# While installing: blue blinks fast, unless the network watcher (below) has flagged "no network", then red is steady.
NET_FLAG="${BOBCAT_NET_FLAG:-/run/bobcat-firstboot.nonet}"
led_busy() {
    ( while :; do
        if [[ -e "$NET_FLAG" ]]; then led_show 0 0 1; sleep 0.3
        else led_show 1 0 0; sleep 0.15; led_show 0 0 0; sleep 0.15; fi
      done ) >/dev/null 2>&1 &
    LED_PID=$!
}
WATCH_PID=""
net_watch_stop() {
    if [[ -n "$WATCH_PID" ]]; then kill "$WATCH_PID" 2>/dev/null; wait "$WATCH_PID" 2>/dev/null; WATCH_PID=""; fi
    rm -f "$NET_FLAG"
    return 0
}
led() {   # led busy|retry|complete
    led_stop
    case "$1" in
        busy)  led_busy ;;
        retry) net_watch_stop; led_blink 0 0 1 1 1 ;;
        complete) net_watch_stop; led_show 0 1 0 ;;
    esac
    return 0
}
trap 'net_watch_stop; led_stop; [[ -n "$HIDDEN_MP" ]] && { umount "$HIDDEN_MP" 2>/dev/null; rmdir "$HIDDEN_MP" 2>/dev/null; }' EXIT

BAKED="$SEED/install.conf"            # baked into the image at build time (optional)
EFFECTIVE="$SEED/effective.conf"      # what the installer is given
BOOT_CONF="$(locate bobcat-install.conf || true)"

mkdir -p "$STATE"
exec > >(tee -a "$LOG") 2>&1
echo "== $(date -Is) bobcat-firstboot starting"

[[ -e "$DONE" ]] && { echo "already done"; exit 0; }
[[ -x "$INSTALLER" ]] || { echo "installer missing: $INSTALLER"; exit 1; }
led busy

# The install needs the internet, so say at once when there is none: while no IPv4 address has shown up after a short
# grace period the LED is steady red, and it goes back to blue as soon as one does. This only watches. It never blocks
# the install: the installer is what applies the Wi-Fi and Ethernet settings, so on a freshly flashed unit the network
# does not exist until it has run.
NET_POLL="${BOBCAT_NET_POLL:-1}" NET_GRACE="${BOBCAT_NET_GRACE:-20}"
have_network() {
    if [[ -n "${BOBCAT_NET_CHECK:-}" ]]; then bash -c "$BOBCAT_NET_CHECK"
    else [[ -n "$(ip -4 -o addr show scope global 2>/dev/null)" ]]; fi
}
net_watch() {
    local n=0
    while :; do
        if have_network; then
            n=0
            [[ -e "$NET_FLAG" ]] && { rm -f "$NET_FLAG"; echo "network is up: $(ip -4 -o addr show scope global 2>/dev/null | head -1)"; }
        else
            n=$((n + 1))
            if [[ "$n" -ge "$NET_GRACE" && ! -e "$NET_FLAG" ]]; then
                : > "$NET_FLAG"; echo "no network address after $NET_GRACE checks: LED red until one appears (cable or Wi-Fi settings?)"
            fi
        fi
        sleep "$NET_POLL"
    done
}
if [[ "$SKIP_SYSTEM" != "1" || -n "${BOBCAT_NET_CHECK:-}" ]]; then net_watch & WATCH_PID=$!; fi

# Never let an automatic upgrade replace the kernel or bootloader: the image
# documentation warns that doing so breaks boot.
if [[ "$SKIP_SYSTEM" != "1" ]]; then
    for pkg in linux-image-current-rockchip64 linux-dtb-current-rockchip64 \
               linux-u-boot-bobcat-29x-current; do
        dpkg -s "$pkg" >/dev/null 2>&1 && apt-mark hold "$pkg" >/dev/null
    done
fi

key_is_set() { grep -qE "^[[:space:]]*$1[[:space:]]*=[[:space:]]*[^[:space:]]" "$EFFECTIVE"; }

# Copy one optional side file into the system and point the config at it,
# unless the settings file already names one itself.
attach_side_file() {   # attach_side_file <name on boot partition> <name here> <KEY>
    local src dest="$SEED/files/$2" key="$3"
    src="$(locate "$1")" || return 0
    note_source "$src"
    if key_is_set "$key"; then
        echo "$1: not used, the settings file already sets $key"
        return 0
    fi
    install -m 600 "$src" "$dest"
    printf '%s=%s\n' "$key" "$dest" >> "$EFFECTIVE"
    echo "using $1"
}

seed_config() {
    install -d -m 700 "$SEED" "$SEED/files"
    : > "$EFFECTIVE"
    chmod 600 "$EFFECTIVE"

    if [[ -r "$BAKED" ]]; then
        echo "reading settings baked into the image"
        { echo "# --- baked into the image"; tr -d '\r' < "$BAKED"; echo; } >> "$EFFECTIVE"
    fi
    if [[ -n "$BOOT_CONF" && -r "$BOOT_CONF" ]]; then
        note_source "$BOOT_CONF"
        echo "reading $BOOT_CONF"
        { echo "# --- $BOOT_CONF"; tr -d '\r' < "$BOOT_CONF"; echo; } >> "$EFFECTIVE"
    else
        echo "no bobcat-install.conf in $BOOT_DIR${HIDDEN_BOOT_DIR:+ or $HIDDEN_BOOT_DIR}: installing with defaults (wired network needed)"
    fi

    attach_side_file bobcat-authorized_keys authorized_keys SSH_AUTHORIZED_KEYS_FILE
    attach_side_file bobcat-reticulum.conf  reticulum.conf  RETICULUM_CONFIG_FILE
    attach_side_file bobcat-wireguard.conf  wireguard.conf  WIREGUARD_CONFIG_FILE
    # A complete netplan file replaces the Wi-Fi/Ethernet settings, so it cannot
    # be combined with them.
    if [[ -n "$(locate bobcat-netplan.yaml)" ]] &&
       grep -qE '^[[:space:]]*(WIFI_SSID|ETH_MODE[[:space:]]*=[[:space:]]*(dhcp|static))' "$EFFECTIVE"; then
        echo "bobcat-netplan.yaml: not used, the settings file already configures Wi-Fi/Ethernet"
    else
        attach_side_file bobcat-netplan.yaml netplan.yaml NETPLAN_FILE
    fi
}

seed_config

# The board has no battery-backed clock. A stale clock makes TLS (apt, pip) fail with "certificate is not yet valid",
# so the clock has to be right before packages are fetched. With no network address yet there is nothing to sync
# from, and waiting here would hold up the very step that brings the network up (the installer applies the Wi-Fi
# and Ethernet settings), so go straight on: the installer waits for the clock itself once the network is up.
if [[ "$SKIP_SYSTEM" != "1" || -n "${BOBCAT_NET_CHECK:-}" ]] && ! have_network; then
    echo "no network yet: not waiting for the clock here; the installer brings the network up and then waits for it"
else
    echo "waiting for time sync (up to 3 min)"
    for _ in $(seq 1 90); do
        [[ "$SKIP_SYSTEM" == "1" ]] && break
        [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" == "yes" ]] && break
        sleep 2
    done
fi
echo "clock: $(date -Is) synchronized=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)"

echo "running the installer with $EFFECTIVE"
if ! "$INSTALLER" --config "$EFFECTIVE"; then
    echo "== installer failed; retrying in about ${RETRY_WAIT}s"
    led retry
    sleep "$RETRY_WAIT"      # keep running so the red blink continues; systemd restarts us right after
    exit 1
fi

touch "$DONE"

# Do not leave secrets sitting in plain text on the FAT partition (readable from
# any computer). The root-only copy under $SEED keeps them for re-runs.
if [[ -n "$BOOT_CONF" && -w "$BOOT_CONF" ]] && ! grep -qE '^[[:space:]]*SCRUB_BOOT_CONF[[:space:]]*=[[:space:]]*(no|false|0|off)' "$BOOT_CONF" &&
   grep -qE '^[[:space:]]*(WIFI_PASS|IFAC_PASSPHRASE|CLOUDFLARE_API_TOKEN|WIREGUARD_CONFIG_B64)[[:space:]]*=[^[:space:]]' "$BOOT_CONF"; then
    sed -i -E 's/^([[:space:]]*(WIFI_PASS|IFAC_PASSPHRASE|CLOUDFLARE_API_TOKEN|WIREGUARD_CONFIG_B64)[[:space:]]*=).*/\1/' "$BOOT_CONF" &&
        echo "cleared passphrases in $BOOT_CONF"
fi
# A WireGuard config handed over as a file holds the private key too: blank it once it is installed.
WG_SIDE="$(locate bobcat-wireguard.conf || true)"
if [[ -n "$WG_SIDE" && -w "$WG_SIDE" && -s "$WG_SIDE" ]] && grep -qi 'PrivateKey' "$WG_SIDE" &&
   ! { [[ -n "$BOOT_CONF" ]] && grep -qE '^[[:space:]]*SCRUB_BOOT_CONF[[:space:]]*=[[:space:]]*(no|false|0|off)' "$BOOT_CONF"; }; then
    printf '# The WireGuard config was installed on the node (/etc/wireguard); its private key is not kept here.\n' > "$WG_SIDE" &&
        echo "cleared the private key in $WG_SIDE"
fi
[[ "$SKIP_SYSTEM" == "1" ]] || systemctl disable bobcat-firstboot.service >/dev/null 2>&1 || true

# Everything above sits in the page cache. Green means "safe to power off", so reach the disk first: a reset
# right after green would otherwise lose the config and the done marker and the install would start over.
sync
led complete
echo "== $(date -Is) first-boot install complete"
exit 0
