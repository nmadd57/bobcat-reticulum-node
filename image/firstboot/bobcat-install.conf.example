# Copy this file to the SD card's boot partition (the small FAT partition,
# labelled "armbi_boot") as: bobcat-install.conf
# before first boot. All settings are optional.

# --- Wi-Fi (2.4 GHz only on this hardware) --------------------------------
#WIFI_SSID=MyNetwork
#WIFI_PASS=my passphrase here
#WIFI_HIDDEN=0
#WIFI_OPEN=0

# --- Radio (must match the other nodes on your network) -------------------
#FREQUENCY=915000000
#BANDWIDTH=125000
#SPREADINGFACTOR=8
#CODINGRATE=5
#TXPOWER=14

# --- Reticulum behaviour --------------------------------------------------
#TRANSPORT=yes
#AUTOINTERFACE=yes

# Clear WIFI_PASS from this file after a successful install (default yes).
#SCRUB_BOOT_CONF=yes

# For a complete netplan config instead of the Wi-Fi shortcut, put it next to
# this file as bobcat-netplan.yaml (ignored when WIFI_SSID is set).
