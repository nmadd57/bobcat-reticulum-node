# Experimental: DHCP + TFTP for U-Boot PXE on an isolated provisioning network.
# Adjust the interface and addresses. Untested with real hardware.
interface=eth1
bind-interfaces
dhcp-range=192.0.2.100,192.0.2.150,12h
dhcp-option=option:router,192.0.2.1

enable-tftp
tftp-root=/srv/tftp

# The DHCP boot filename and next-server (this host) tell U-Boot where to look.
# U-Boot's `pxe get` then asks for pxelinux.cfg/<uuid>, 01-<mac>, <ip-in-hex>,
# ..., default in that directory. How the directory is derived from the
# filename depends on the U-Boot version: check doc/README.pxe for yours.
dhcp-boot=pxelinux.0,,192.0.2.1
